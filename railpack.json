{
  "$schema": "https://schema.railpack.com",
  "name": "agentic-insurance-advisor",
  "packages": {
    "python": "3.12"
  },
  "buildAptPackages": ["curl"],
  "env": {
    "PYTHONUNBUFFERED": "1"
  },
  "deploy": {
    "startCommand": "cd backend && uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"
  }
}
