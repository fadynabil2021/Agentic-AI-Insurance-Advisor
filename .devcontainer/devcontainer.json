{
  "name": "Agentic Insurance Advisor",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": "true"
    }
  },
  "forwardPorts": [3000, 8000, 3001, 8001],
  "portsAttributes": {
    "3000": { "label": "Next.js Chat UI", "onAutoForward": "openBrowser" },
    "8000": { "label": "FastAPI Backend", "onAutoForward": "silent" },
    "3001": { "label": "Langfuse UI", "onAutoForward": "silent" }
  },
  "postCreateCommand": "cp .env.example .env && docker compose -f docker-compose.yml -f .devcontainer/docker-compose.demo.yml up -d --build",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
