# ─────────────────────────────────────────────────────────────────
# Agentic Insurance Advisor — Environment Variables
# Copy this file to .env and fill in the required values.
# ─────────────────────────────────────────────────────────────────

# ── Ollama ───────────────────────────────────────────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120

# ── ChromaDB ─────────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300

# ── Langfuse (REQUIRED — generate in Langfuse UI Step 5) ─────────
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Agent ────────────────────────────────────────────────────────
MAX_RETRIES=2
MIN_CONFIDENCE_THRESHOLD=0.4
